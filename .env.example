# Optional overrides. Copy to .env; defaults work on the target M1 Mac.
ARXIV_AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
ARXIV_AGENT_GENERATION_MODEL=qwen2.5:3b
ARXIV_AGENT_CONTEXT_TOKENS=4096
ARXIV_AGENT_QA_MAX_DISTANCE=0.85
ARXIV_AGENT_CANDIDATE_COUNT=30
ARXIV_AGENT_CANDIDATE_OLDEST_COUNT=50
ARXIV_AGENT_CANDIDATE_PHRASE_COUNT=20
ARXIV_AGENT_OCR_ENABLED=true
ARXIV_AGENT_OCR_DPI=150
ARXIV_AGENT_DATA_DIR=data
ARXIV_AGENT_OUTPUT_DIR=outputs
ARXIV_AGENT_MODEL_CACHE_DIR=.cache/huggingface
ARXIV_AGENT_LOG_LEVEL=INFO
