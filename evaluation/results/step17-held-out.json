    {
      "id": "Q2",
      "split": "held_out",
      "paper_id": "2305.14314v1",
      "question": "What is the purpose of QLoRA's 4-bit NormalFloat (NF4) data type?",
      "expected_status": "answered",
      "elapsed_seconds": 24.663,
      "error": null,
      "answer": {
        "status": "answered",
        "text": "The 4-bit NormalFloat (NF4) data type in QLoRA is designed to be information theoretically optimal for normally distributed weights, aiming to reduce memory usage without sacrificing performance.",
        "citations": [
          {
            "chunk_id": "2305.14314v1-33a4e757c19d-p1-sd21b4a64-g1-c0-25f3b98821b4",
            "arxiv_id": "2305.14314",
            "version": 1,
            "page": 1,
            "section": "Abstract"
          },
          {
            "chunk_id": "2305.14314v1-33a4e757c19d-p4-sfccfd817-g7-c0-58e13c13bae4",
            "arxiv_id": "2305.14314",
            "version": 1,
            "page": 4,
            "section": "QLORA Finetuning"
          },
          {
            "chunk_id": "2305.14314v1-33a4e757c19d-p24-sfa13ce2d-g43-c0-97494c3b2bc1",
            "arxiv_id": "2305.14314",
            "version": 1,
            "page": 24,
            "section": "NormalFloat 4-bit data type"
          }
        ]
      },
      "support_quotes": [
