      "support_quotes": [
        {
          "chunk_id": "1706.03762v1-0a9bff1be357-p1-sd21b4a64-g1-c0-ad65c9963b57",
          "source_quote": "We propose a new simple network architecture, the Transformer, based solely on attention mechanisms, dispensing with recurrence and convolutions entirely."
        },
        {
          "chunk_id": "1706.03762v1-0a9bff1be357-p2-sb605350b-g3-c0-b35351af4f45",
          "source_quote": "Attention mechanisms have become an integral part of compelling sequence modeling and transduc-tion models in various tasks, allowing modeling of dependencies without regard to their distance in the input or output sequences [2, 17]."
        },
        {
          "chunk_id": "1706.03762v1-0a9bff1be357-p2-s8f572f78-g5-c0-e0552706aae9",
          "source_quote": "The Transformer follows this overall architecture using stacked self-attention and point-wise, fully connected layers for both the encoder and decoder, shown in the left and right halves of Figure 1, respectively."
        }
      ],
