      "question": "What does LoRA freeze during training?",
      "expected_status": "answered",
      "elapsed_seconds": 24.609,
      "error": null,
      "answer": {
        "status": "answered",
        "text": "LoRA freezes the pre-trained model weights and injects trainable rank decomposition matrices into each layer of the Transformer architecture, reducing the number of trainable parameters for downstream tasks.",
